{
  "name": "torflix",
  "productName": "Torflix",
  "version": "0.3.0",
  "description": "Torflix for Android TV and the desktop: browse what performs best on the swarm and stream it. Built on the design of TorrentPlayer.",
  "homepage": "https://github.com/gary23w/torflix",
  "author": {
    "name": "Garrett Stimpson",
    "email": "info@garrettstimpson.ca",
    "url": "https://garrettstimpson.ca"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gary23w/torflix.git"
  },
  "bugs": "https://github.com/gary23w/torflix/issues",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder",
    "dist:desktop": "node tools/distribution/build-desktop.mjs",
    "android:build": "node tools/android/build.mjs",
    "android:release": "node tools/android/release.mjs"
  },
  "dependencies": {
    "parse-torrent": "^11.0.24",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "io.torflix.app",
    "productName": "Torflix",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "!src/android/**/*",
      "assets/**/*",
      "!assets/demo/**/*",
      "!assets/screens/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Torflix-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video",
      "icon": "assets/icon.png"
    }
  }
}
